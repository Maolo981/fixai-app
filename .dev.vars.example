# Copia questo file in .dev.vars per lo sviluppo locale (non va mai committato).
# Senza chiave Stripe, ALLOW_FREE_ACTIVATION=true permette di attivare gli inviti gratis in locale.
ALLOW_FREE_ACTIVATION=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
ADMIN_PASSWORD=cambiami
