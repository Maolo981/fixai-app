{
  "name": "confetto",
  "version": "1.0.0",
  "private": true,
  "description": "Inviti digitali con conferme di presenza (RSVP) per matrimoni, battesimi, comunioni, lauree e feste.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "og": "node scripts/og-images.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
